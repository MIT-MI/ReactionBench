# ReactionBench data pipeline — environment template.
# Copy to data_pipeline/.env (gitignored) and fill in. Every script loads it via
# common/rvb_config.py; variables already set in the shell take precedence.
# Never commit the filled-in file.

# ---------------------------------------------------------------- filesystem roots
# Raw downloads + per-domain pipeline outputs (raw/<label>/, face/, stimuli/, ...)
RVB_RAW_ROOT=/path/to/human_reaction_data
# Consolidated clip pool: face_origin/, stimuli/, face_segments/, stimuli_description/,
# face_intensity_series/, face_intensity_avg/, _meta/{mapping.csv,youtuber_id_map.json,...}
RVB_DATA_ROOT=/path/to/clean_human_reaction_data
# Re-aligned stimuli for desynchronised Patreon clips (default: <RVB_DATA_ROOT>_recut)
RVB_RECUT_ROOT=/path/to/clean_human_reaction_data_recut
# Intermediate tables / nominations / selections / task exports (default: data_pipeline/work)
RVB_WORK_DIR=
# Structured JSON run logs (default: $RVB_WORK_DIR/logs)
RVB_LOG_DIR=

# Stage 01 inputs (manually curated playlist registry and the catalog it produces)
RVB_PLAYLISTS_CSV=all_playlists.csv
RVB_CATALOG=youtube_catalog-new.csv
# yt-dlp cookies file (Netscape format) for age-gated / members-only videos. Do not commit it.
YTDLP_COOKIES=

# ---------------------------------------------------------------- Google Gemini
# Vertex AI (pre-screen nomination, stimulus descriptions, selection passes). Auth via
# `gcloud auth application-default login`; no key is stored here.
GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>
GOOGLE_CLOUD_LOCATION=global
# Gemini Developer API keys (scripts that support --gemini-auth api-key / generate_video_list.py)
GEMINI_API_KEY=
# Comma-separated pool of keys for the multi-key client (optional)
GEMINI_API_KEYS=

# ---------------------------------------------------------------- Tinker (rationale drafts, 06)
TINKER_API_KEY=
# Optional extra keys used round-robin: TK_API_KEY_1 ... TK_API_KEY_5

# ---------------------------------------------------------------- Supabase (annotation backend)
SUPABASE_URL=https://<your-project>.supabase.co
# Publishable/anon key: read-only under the RLS policies in 06_annotate/sql/
SUPABASE_ANON_KEY=<supabase-publishable-anon-key>
# Service-role key: needed only by loaders that insert tasks. Keep it out of every frontend.
SUPABASE_SECRET_KEY=<supabase-service-role-key>
# Postgres connection string (06_annotate/scene_cuts.py writes via psycopg)
SUPABASE_CONNECTION_STRING=postgresql://postgres:<password>@<host>:5432/postgres

# ---------------------------------------------------------------- Cloudflare R2 (clip hosting)
R2_S3_API=https://<account-id>.r2.cloudflarestorage.com
# Access key ID (the scripts read R2_ACCESS_SECRET_ID; R2_ACCESS_KEY_ID is also accepted)
R2_ACCESS_SECRET_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=<bucket-name>
# Public read base URL of the bucket (custom domain or the bucket's public r2.dev URL)
R2_PUBLIC_BASE_URL=https://<your-public-r2-bucket-domain>/

# ---------------------------------------------------------------- third-party model checkouts (02)
# AudioSep (https://github.com/Audio-AGI/AudioSep), used by some per-domain pipelines
AUDIOSEP_ROOT=/path/to/AudioSep
AUDIOSEP_CHECKPOINT_DIR=/path/to/AudioSep/checkpoint
# Override the bundled 02_align/talking_head tool (optional)
TALKING_HEAD_ROOT=
# Host conda env with `libreface` installed, for 04_features/docker/libreface/run_libreface.sh
LIBREFACE_ENV=/path/to/conda/envs/libreface
